{
  "name": "@bassotov/deck",
  "version": "0.5.1",
  "type": "module",
  "description": "PowerPoint for agents. Your agent writes the deck as plain markdown; you open it and draw on it while you record.",
  "license": "MIT",
  "author": "Pasha Barbashin (https://github.com/bassotov)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bassotov/deck.git"
  },
  "homepage": "https://github.com/bassotov/deck#readme",
  "bugs": "https://github.com/bassotov/deck/issues",
  "keywords": [
    "slides",
    "presentation",
    "markdown",
    "annotation",
    "screencast",
    "build-in-public",
    "deck",
    "mcp",
    "mcp-server"
  ],
  "bin": {
    "deck": "lib/bin/deck.js"
  },
  "files": [
    "lib",
    "dist",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD-PARTY-LICENSES.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:node",
    "build:client": "vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p test/tsconfig.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test 'test/*.test.ts'",
    "export": "npm run build && node lib/scripts/export.js",
    "start": "npm run build && node lib/bin/deck.js",
    "mcp": "npm run build && node lib/bin/deck.js mcp",
    "prepublishOnly": "npm run typecheck && npm run build",
    "bundle": "npm run build && node lib/scripts/bundle.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "marked": "^18.0.7",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
